{
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build && pnpm browser:imports && pnpm browser:worker",
    "browser:imports": "node scripts/verify-browser-imports.mjs",
    "browser:worker": "node scripts/verify-worker-build.mjs",
    "pack:verify": "node scripts/verify-packed-packages.mjs",
    "release:verify": "node scripts/verify-release-tag.mjs",
    "test:release": "node --test scripts/verify-release-tag.test.mjs",
    "test": "vitest run packages && node scripts/verify-verbal-identity.mjs",
    "bench:composition": "pnpm --filter @openbindings/invoke bench:composition",
    "conformance": "pnpm --filter @openbindings/core conformance",
    "correspondence": "node scripts/verify-reference-correspondence.mjs",
    "lint": "pnpm -r --filter './packages/*' run lint && eslint . --ignore-pattern 'packages/**'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.3"
  }
}

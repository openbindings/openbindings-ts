+        const node = compileSchema({type:"number"});
+        const seen: string[] = []; node.validators.push(({pointer}) => { seen.push(pointer); });
+        assert.equal(branchValidity(1,"#/a")(node,[]),true);
+        assert.equal(branchValidity("1","#/a")(node,[]),false);
+        assert.equal(branchValidity(1,"#/b")(node,[]),true);
+        assert.deepEqual(seen,["#/a","#/a","#/b"]);
+    });
+    it("does not cache a throwing evaluation", () => {

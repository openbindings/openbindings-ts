+import { ValidationPath } from "./Keyword";
+import { isJsonError, SchemaNode } from "./types";
+import { validateNode } from "./validateNode";
+
+/**
+ * Evaluate a speculative branch without appending its traversal to the caller's
+ * path. Keep the full result so callers that report diagnostics do not lose it.
+ */
+export function validateBranch(node: SchemaNode, data: unknown, pointer: string, path: ValidationPath) {
+    return validateNode(node, data, pointer, [...(path ?? [])]);
+}
+
+/**
+ * Synchronous validity, matching SchemaNode.validate().valid: annotations are
+ * not errors. This does not await or define validity for custom async keywords.
+ */
+export function isValidBranch(node: SchemaNode, data: unknown, pointer: string, path: ValidationPath) {
+    return !validateBranch(node, data, pointer, path).some(isJsonError);
+}

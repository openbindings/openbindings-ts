+        assert.equal(check(node,[]),true); assert.equal(check(node,[]),true); assert.equal(visits,2);
+    });
+    it("resolves the same dynamic branch separately under different anchors", () => {
+        const root = compileSchema({$id:"https://audit.invalid/dynamic", $defs:{

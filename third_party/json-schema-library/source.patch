diff --git a/src/validateBranch.test.ts b/src/validateBranch.test.ts
new file mode 100644
index 00000000..4900fbe2
--- /dev/null
+++ b/src/validateBranch.test.ts
@@ -0,0 +1,70 @@
+import {strict as assert} from "assert";
+import {compileSchema} from "./compileSchema";
+import {isValidBranch,validateBranch} from "./validateBranch";
+import {ValidationPath} from "./Keyword";
+import {isJsonAnnotation,isJsonError} from "./types";
+
+describe("speculative branch validity",()=>{
+    it("does not confuse an annotation with a failed assertion",()=>{
+        const node=compileSchema({deprecated:true});
+        const path:ValidationPath=[];
+        assert.equal(isValidBranch(node,1,"#",path),true);
+        assert(validateBranch(node,1,"#",path).some(isJsonAnnotation));
+        assert.deepEqual(path,[]);
+    });
+    it("retains errors and annotations for diagnostic consumers",()=>{
+        const node=compileSchema({deprecated:true,type:"string"});
+        assert.equal(isValidBranch(node,1,"#",[]),false);
+        const result=validateBranch(node,1,"#",[]);
+        assert(result.some(isJsonError));assert(result.some(isJsonAnnotation));
+    });
+    it("never appends speculative traversal to a frozen caller path",()=>{
+        const root=compileSchema({});
+        const path:ValidationPath=[{pointer:"#",node:root}];Object.freeze(path);
+        const branch=compileSchema({anyOf:[{type:"number"},{type:"string"}]});
+        assert.equal(isValidBranch(branch,1,"#/value",path),true);
+        assert.equal(path.length,1);assert.equal(path[0].node,root);
+    });
+    it("keeps repeated reference decisions stable",()=>{
+        const node=compileSchema({$defs:{n:{deprecated:true,type:"number"}},oneOf:[{$ref:"#/$defs/n"},{type:"string"}]});
+        for(let i=0;i<5;i++){
+            assert.equal(node.validate(1).valid,true);
+            assert.equal(node.validate(null).valid,false);
+        }
+    });
+    for(const combinator of ["anyOf","oneOf"])for(const kind of ["properties","items"]){
+        const object=kind==="properties",annotation=object?"additionalProperties":"items",unevaluated=object?"unevaluatedProperties":"unevaluatedItems",count=object?"maxProperties":"maxItems";
+        it(`ignores failed ${combinator} ${kind} contributors`,()=>{
+            const node=compileSchema({[combinator]:[{[annotation]:true,[count]:0},{type:object?"object":"array"}],[unevaluated]:false});
+            assert.equal(node.validate(object?{x:1}:[1]).valid,false);
+        });
+    }
+    for(const kind of ["properties","items"]){
+        const object=kind==="properties",annotation=object?"additionalProperties":"items",unevaluated=object?"unevaluatedProperties":"unevaluatedItems";
+        it(`accepts valid annotated ${kind} contributors`,()=>{
+            const node=compileSchema({anyOf:[{deprecated:true,[annotation]:true},{type:object?"object":"array"}],[unevaluated]:false});
+            assert.equal(node.validate(object?{x:1}:[1]).valid,true);
+        });
+        it(`does not use a failed if predicate to evaluate ${kind}`,()=>{
+            const node=compileSchema({if:{[annotation]:true,[object?"maxProperties":"maxItems"]:0},else:{type:object?"object":"array"},[unevaluated]:false});
+            assert.equal(node.validate(object?{x:1}:[1]).valid,false);
+        });
+    }
+    it("selects then for a valid annotation-only predicate",()=>{
+        assert.equal(compileSchema({if:{deprecated:true},then:false,else:true}).validate(1).valid,false);
+        assert.equal(compileSchema({if:{deprecated:true},then:true,else:false}).validate(1).valid,true);
+    });
+    it("counts valid annotated oneOf alternatives",()=>{
+        assert.equal(compileSchema({oneOf:[{deprecated:true},{}]}).validate(1).valid,false);
+    });
+    it("handles annotated contains and not predicates",()=>{
+        assert.equal(compileSchema({contains:{deprecated:true},unevaluatedItems:false}).validate([1]).valid,true);
+        assert.equal(compileSchema({not:{deprecated:true}}).validate(1).valid,false);
+    });
+    it("retains the existing synchronous public treatment of pending async results",()=>{
+        const node=compileSchema({});
+        node.validators.push(()=>Promise.resolve(undefined));

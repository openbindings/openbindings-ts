diff --git a/src/coverageReferences.ts b/src/coverageReferences.ts
new file mode 100644
index 00000000..2c002976
--- /dev/null
+++ b/src/coverageReferences.ts
@@ -0,0 +1,45 @@
+import { ValidationPath } from "./Keyword";
+import { isSchemaNode, SchemaNode } from "./types";
+
+type Entry = {
+    incoming: ValidationPath;
+    appended: ValidationPath;
+    resolved: SchemaNode;
+};
+
+const copyPath = (path: ValidationPath): ValidationPath => path.map((entry) => ({ ...entry }));
+const samePath = (a: ValidationPath, b: ValidationPath) =>
+    a.length === b.length && a.every((entry, i) => entry.node === b[i].node && entry.pointer === b[i].pointer);
+
+/** Private reference-target reuse for one synchronous property-coverage scan.
+ * Keep this closure local to that scan. Schema/registry/extension state must
+ * remain stable during it; no results survive into another validation call.
+ */
+export function coverageReferences(pointer: string) {
+    const entries = new Map<SchemaNode, Entry[]>();
+
+    return (node: SchemaNode, path: ValidationPath): SchemaNode => {
+        const matches = entries.get(node);
+        const cached = matches?.find((entry) => samePath(entry.incoming, path));
+        if (cached) {
+            // Resolution also contributes dynamic scope. Reproduce that effect
+            // on this walk's path without exposing our retained path entries.
+            for (const entry of cached.appended) path.push({ ...entry });
+            return cached.resolved;
+        }
+
+        const incoming = copyPath(path);
+        const resolved = node.resolveRef({ pointer, path });
+        if (
+            resolved !== node && isSchemaNode(resolved) &&
+            path.length >= incoming.length && samePath(incoming, path.slice(0, incoming.length))
+        ) {
+            const entry = { incoming, resolved, appended: copyPath(path.slice(incoming.length)) };
+            if (matches) matches.push(entry);
+            else entries.set(node, [entry]);
+        }
+        // Errors, throws, self/identity results and non-append path mutations
+        // are never reused. The original resolver determines all outcomes.
+        return resolved;
+    };
+}

{
  "name": "@openbindings/json",
  "version": "0.2.0",
  "description": "Exact JSON values for TypeScript: plain data with rich leaves, an exact Decimal and a byte-backed Encoded string",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "browser": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.browser.js"
      },
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./internal": {
      "browser": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.browser.js"
      },
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./values": {
      "browser": {
        "types": "./dist/values.d.ts",
        "default": "./dist/values.browser.js"
      },
      "import": {
        "types": "./dist/values.d.ts",
        "default": "./dist/values.js"
      },
      "require": {
        "types": "./dist/values.d.cts",
        "default": "./dist/values.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "VALUES.md",
    "LEGACY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/entries.mjs",
    "test": "vitest run",
    "bench": "vitest bench --run src/values.bench.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepack": "tsup && node scripts/entries.mjs"
  },
  "dependencies": {
    "core-js-pure": "3.50.0",
    "lossless-json": "4.3.1"
  }
}

{
  "name": "@openbindings/json",
  "version": "0.2.0",
  "description": "Protocol-neutral exact JSON carriage using existing standard-library implementations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": { ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } } },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "scripts": { "build": "tsup", "test": "vitest run", "lint": "tsc --noEmit" },
  "dependencies": { "core-js-pure": "3.50.0", "lossless-json": "4.3.1" }
}

{
  "formatVersion": "1.0.0",
  "policyId": "openbindings.reference-composition@1",
  "cases": [
    {
      "id": "SCOMP-F01-exact-available",
      "consumer": {
        "openbindings": "0.2.0",
        "operations": {
          "deliver": {
            "input": { "type": "string", "pattern": "^[a-z]+$" },
            "output": { "type": "string" }
          }
        },
        "dependencies": {
          "delivery": {
            "operation": "deliver",
            "bindingSpecs": ["example.local@1"]
          }
        }
      },
      "providers": [
        {
          "key": "primary",
          "preference": 0,
          "runtimeBindingSpecs": ["example.local@1"],
          "interface": {
            "openbindings": "0.2.0",
            "operations": {
              "send": {
                "aliases": ["deliver"],
                "input": { "pattern": "^[a-z]+$", "type": "string" },
                "output": { "type": "string" }
              }
            },
            "sources": {
              "local": {
                "bindingSpec": "example.local@1",
                "content": { "handler": "send" }
              }
            },
            "bindings": {
              "send.local": {
                "operation": "send",
                "source": "local",
                "ref": "send"
              }
            }
          }
        }
      ],
      "dependency": "delivery",
      "invocation": { "input": "hello", "output": "hello" },
      "expected": {
        "status": "available",
        "providerKey": "primary",
        "bindingKey": "send.local",
        "assessmentCodes": []
      }
    },

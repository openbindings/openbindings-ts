{
  "name": "@openbindings/core",
  "version": "0.2.0",
  "description": "OpenBindings core layer: the spec-defined document model — parse, validate, resolve, and verify OBI interfaces.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/shared-runtime-entry.mjs",
    "prepack": "tsup && node ../../scripts/shared-runtime-entry.mjs",
    "test": "vitest run",
    "conformance": "node --import tsx scripts/run-conformance.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json && eslint ."
  },
  "keywords": [
    "openbindings",
    "obi",
    "api",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/openbindings-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://openbindings.com",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openbindings/json": "workspace:*",
    "@openbindings/json-schema": "workspace:*",
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "json-schema-library": "11.6.2",
    "jsonata": "2.1.1"
  }
}

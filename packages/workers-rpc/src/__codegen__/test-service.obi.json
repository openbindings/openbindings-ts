{
  "openbindings": "0.1.0",
  "name": "TestWorkersRpc",
  "version": "0.1.0",
  "operations": {
    "ping": {
      "description": "Health check",
      "input": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "output": {
        "type": "object",
        "required": ["echoed"],
        "properties": { "echoed": { "type": "string" } }
      }
    },
    "addItem": {
      "description": "Add an item to the store",
      "input": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "qty": { "type": "integer" }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "id": { "type": "string" }
        }
      }
    }
  },
  "sources": {
    "rpc": {
      "format": "workers-rpc@^1.0.0",
      "location": "workers-rpc://test-service"
    }
  },
  "bindings": {
    "ping.rpc": { "operation": "ping", "source": "rpc", "ref": "ping" },
    "addItem.rpc": { "operation": "addItem", "source": "rpc", "ref": "addItem" }
  }
}

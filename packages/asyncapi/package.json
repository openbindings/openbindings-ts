{
  "name": "@openbindings/asyncapi",
  "version": "0.2.0",
  "description": "OpenBindings AsyncAPI binding invoker",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json && eslint ."
  },
  "keywords": [
    "openbindings",
    "asyncapi",
    "invoker",
    "events"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/openbindings-ts.git",
    "directory": "packages/asyncapi"
  },
  "homepage": "https://openbindings.com",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openbindings/asyncapi-client": "^0.1.0"
  },
  "peerDependencies": {
    "@openbindings/core": "^0.2.0",
    "@openbindings/invoke": "^0.2.0",
    "@openbindings/synthesize": "^0.2.0"
  },
  "devDependencies": {
    "@openbindings/core": "workspace:*",
    "@openbindings/invoke": "workspace:*",
    "@openbindings/synthesize": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.0"
  }
}

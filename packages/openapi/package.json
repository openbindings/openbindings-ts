{
  "name": "@openbindings/openapi",
  "version": "0.2.0",
  "description": "OpenBindings OpenAPI/HTTP binding invoker",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ."
  },
  "keywords": [
    "openbindings",
    "openapi",
    "invoker",
    "http",
    "rest"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/openbindings-ts.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://openbindings.com",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@openbindings/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@openbindings/sdk": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.0.0"
  }
}

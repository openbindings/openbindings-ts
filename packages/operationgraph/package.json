{
  "name": "@openbindings/operationgraph",
  "version": "0.2.0",
  "description": "OpenBindings operation-graph binding invoker",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json && eslint ."
  },
  "keywords": [
    "openbindings",
    "operation-graph",
    "invoker",
    "binding",
    "graph",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/openbindings-ts.git",
    "directory": "packages/operationgraph"
  },
  "homepage": "https://openbindings.com",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@openbindings/core": "^0.2.0",
    "@openbindings/invoke": "^0.2.0"
  },
  "devDependencies": {
    "@openbindings/core": "workspace:*",
    "@openbindings/invoke": "workspace:*",
    "@types/node": "^22.0.0",
    "jsonata": "2.1.1"
  }
}

+            const root=fixture(),site=root.anyOf![0],calls=spy(site),resolve=coverageReferences("#");
+            const a:ValidationPath=[{node:root,pointer:"#"},{node:site,pointer:"#/child"}];
+            const b=a.map(e=>({...e}));
+            if(change==="append")b.push({node:root,pointer:"#/extra"});
+            if(change==="pointer")b[0].pointer="#/different";
+            if(change==="node")b[0].node=site;
+            if(change==="reorder")b.reverse();
+            if(change==="remove")b.pop();

diff --git a/src/branchValidity.test.ts b/src/branchValidity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96dfce4f1c7400c764fcb6d59210ecb297fac314
--- /dev/null
+++ b/src/branchValidity.test.ts
@@ -0,0 +1,135 @@
+import { strict as assert } from "assert";
+import { compileSchema } from "./compileSchema";
+import { branchValidity } from "./branchValidity";
+import { ValidationPath } from "./Keyword";
+
+describe("scan-local whole-branch validity", () => {
+    for (const valid of [true, false]) {
+        it(`reuses a synchronous ${valid} result without growing the caller path`, () => {
+            const node = compileSchema(valid ? {deprecated: true} : false);
+            let visits = 0;
+            // Boolean false returns before validators: instrument a schema assertion instead.
+            const branch = valid ? node : compileSchema({type: "string"});
+            branch.validators.push(() => { visits++; });
+            const check = branchValidity(1, "#");
+            const path: ValidationPath = []; Object.freeze(path);
+            assert.equal(check(branch, path), valid);
+            assert.equal(check(branch, []), valid);
+            assert.equal(visits, 1); assert.deepEqual(path, []);
+        });
+    }
+    it("keys by node identity, not equal schema locations", () => {
+        const check = branchValidity(1, "#");
+        assert.equal(check(compileSchema({type: "number"}), []), true);
+        assert.equal(check(compileSchema({type: "string"}), []), false);
+    });
+    for (const change of ["append", "pointer", "node", "reorder", "remove"]) {
+        it(`invalidates when the full path changes: ${change}`, () => {
+            const a = compileSchema({}), b = compileSchema({}), node = compileSchema({});
+            let visits = 0; node.validators.push(() => { visits++; });
+            const path: ValidationPath = [{node:a,pointer:"#"},{node:b,pointer:"#/b"}];
+            const check = branchValidity(1,"#"); check(node,path); check(node,path);
+            if (change === "append") path.push({node:a,pointer:"#/c"});
+            if (change === "pointer") path[0].pointer = "#/changed";
+            if (change === "node") path[0].node = b;
+            if (change === "reorder") path.reverse();
+            if (change === "remove") path.pop();
+            check(node,path); check(node,path); assert.equal(visits,2);
+        });
+    }
+    it("never reuses across independent scans, instances or pointers", () => {
+        const node = compileSchema({type:"number"});
+        const seen: string[] = []; node.validators.push(({pointer}) => { seen.push(pointer); });
+        assert.equal(branchValidity(1,"#/a")(node,[]),true);
+        assert.equal(branchValidity("1","#/a")(node,[]),false);
+        assert.equal(branchValidity(1,"#/b")(node,[]),true);
+        assert.deepEqual(seen,["#/a","#/a","#/b"]);
+    });
+    it("does not cache a throwing evaluation", () => {
+        const node = compileSchema({}); let visits = 0;
+        node.validators.push(() => { if (++visits === 1) throw Error("probe"); });
+        const check = branchValidity(null,"#");
+        assert.throws(() => check(node,[]), /probe/);
+        assert.equal(check(node,[]),true); assert.equal(check(node,[]),true); assert.equal(visits,2);
+    });
+    it("does not cache pending asynchronous evaluations", () => {
+        const node = compileSchema({}); let visits = 0;
+        node.validators.push(() => { visits++; return Promise.resolve([]); });
+        const check = branchValidity(null,"#");
+        assert.equal(check(node,[]),true); assert.equal(check(node,[]),true); assert.equal(visits,2);
+    });
+    it("resolves the same dynamic branch separately under different anchors", () => {
+        const root = compileSchema({$id:"https://audit.invalid/dynamic", $defs:{
+            n:{$id:"num",$dynamicAnchor:"a",type:"number"}, s:{$id:"str",$dynamicAnchor:"a",type:"string"},
+            branch:{$dynamicRef:"num#a"}
+        }});
+        const branch = root.$defs!.branch, check = branchValidity(1,"#");
+        const path: ValidationPath = [{node:root.$defs!.n,pointer:"#"}];
+        assert.equal(check(branch,path),true); assert.equal(check(branch,path),true);
+        path[0].node = root.$defs!.s;
+        assert.equal(check(branch,path),false); assert.equal(check(branch,path),false);
+        path[0].node = root.$defs!.n;
+        assert.equal(check(branch,path),true);
+    });
+    for (const kind of ["properties","items"]) for (const combinator of ["anyOf","oneOf","if"]) {
+        it(`isolates public calls and mutated input for ${kind}/${combinator}`, () => {
+            const object = kind === "properties";
+            const branch = object ? {properties:{a:{type:"number"},b:{type:"number"}}} : {prefixItems:[{type:"number"},{type:"number"}]};
+            const schema = combinator === "if" ? {if:branch,then:true,else:false} : {[combinator]:[branch]};
+            const node = compileSchema({...schema,[object?"unevaluatedProperties":"unevaluatedItems"]:false});
+            const data: any = object ? {a:1,b:2} : [1,2];
+            const key = object ? "a" : 0;
+            const path: ValidationPath = [];
+            assert.equal(node.validate(data,"#",path).valid,true);
+            data[key] = "wrong";
+            assert.equal(node.validate(data,"#",path).valid,false);
+            data[key] = 1;
+            assert.equal(node.validate(data,"#",path).valid,true);
+        });
+    }
+    it("does not share results between two instance positions using the same ref", () => {
+        const node = compileSchema({$defs:{obj:{anyOf:[{properties:{a:{type:"number"}}}],unevaluatedProperties:false}},
+            properties:{left:{$ref:"#/$defs/obj"},right:{$ref:"#/$defs/obj"}}});
+        assert.equal(node.validate({left:{a:1},right:{a:"wrong"}}).valid,false);
+        assert.equal(node.validate({left:{a:1},right:{a:2}}).valid,true);
+    });
+    it("isolates nested reentrant public validation", () => {
+        const inner = compileSchema({anyOf:[{properties:{a:{type:"number"}}}],unevaluatedProperties:false});
+        const outer = compileSchema({anyOf:[{properties:{a:{type:"number"},b:{type:"number"}}}],unevaluatedProperties:false});
+        let calls = 0;
+        outer.anyOf![0].validators.push(() => {
+            calls++; assert.equal(inner.validate({a:"wrong"}).valid,false);
+            assert.equal(inner.validate({a:1}).valid,true);
+        });
+        assert.equal(outer.validate({a:1,b:2}).valid,true); assert.equal(calls,2);
+        assert.equal(outer.validate({a:1,b:2}).valid,true); assert.equal(calls,4);
+    });
+    it("retains separately emitted public annotations", () => {
+        // The upstream anyOf keyword does not emit its children's annotations.
+        // Assert preservation of an annotation that the public validator emits.
+        const node = compileSchema({deprecated:true,anyOf:[{deprecated:true,properties:{a:true,b:true}}],unevaluatedProperties:false});
+        for (let i=0;i<3;i++) {
+            const result = node.validate({a:1,b:2}); assert.equal(result.valid,true);
+            assert.equal(result.annotations.length,1);
+        }
+    });
+    it("keeps referenced property coverage out of the caller path", () => {
+        const node = compileSchema({$defs:{obj:{properties:{a:true,b:true,c:true}}},anyOf:[{$ref:"#/$defs/obj"}],unevaluatedProperties:false});
+        const path: ValidationPath = [];
+        assert.equal(node.validate({a:1,b:2,c:3},"#",path).valid,true);
+        assert.equal(path.length,1); assert.equal(path[0].node,node);
+    });
+    for (const nested of [true,false]) {
+        it(`keeps invalid prefix assertions effective (${nested ? "nested" : "adjacent"})`, () => {
+            const branch = {prefixItems:[{type:"number"}],maxItems:1};
+            const node = compileSchema({...nested?{anyOf:[branch]}:branch,unevaluatedItems:false});
+            assert.equal(node.validate([1]).valid,true);
+            assert.equal(node.validate(["wrong"]).valid,false);
+            assert.equal(node.validate([1,2]).valid,false);
+        });
+    }
+    it("does not collect prefix coverage from an invalid branch", () => {
+        const node = compileSchema({anyOf:[{prefixItems:[true],maxItems:0},{}],unevaluatedItems:false});
+        assert.equal(node.validate([1]).valid,false);
+    });
+});

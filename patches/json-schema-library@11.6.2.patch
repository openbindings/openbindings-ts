+import { ValidationPath } from "./Keyword";
+import { isJsonError, SchemaNode } from "./types";
+import { validateBranch } from "./validateBranch";
+
+/** Private, scan-local whole-branch validity. Not a validation-session cache.
+ * The instance, schema and synchronous extension behavior must remain stable
+ * during the scan. Never retain this closure on a node, context or caller path.
+ */
+export function branchValidity(data: unknown, pointer: string) {
+    let scope: ValidationPath | undefined;
+    const results = new Map<SchemaNode, boolean>();
+
+    return (node: SchemaNode, path: ValidationPath): boolean => {
+        // Compare values, not the mutable path-array identity or its length alone.
+        // A reference resolver may append to the caller's traversal between checks.
+        if (
+            !scope || scope.length !== path.length ||
+            scope.some((entry, i) => entry.node !== path[i].node || entry.pointer !== path[i].pointer)

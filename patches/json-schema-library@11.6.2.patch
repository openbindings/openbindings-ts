+        assert(isJsonError(resolve(node,[])));assert(isJsonError(resolve(node,[])));assert.equal(calls(),2);
+    });
+    it("does not cache exceptions", () => {
+        const root=fixture(),site=root.anyOf![0],original=site.resolveRef;let calls=0;

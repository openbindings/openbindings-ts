+            n:{$id:"num",$dynamicAnchor:"a",type:"number"},s:{$id:"str",$dynamicAnchor:"a",type:"string"},
+            site:{$dynamicRef:"num#a"}
+        }});
+        const site=root.$defs!.site,calls=spy(site),resolve=coverageReferences("#");
+        const n=resolve(site,[{node:root.$defs!.n,pointer:"#"}]);
+        const s=resolve(site,[{node:root.$defs!.s,pointer:"#"}]);

+        const resolve=coverageReferences("#");assert.throws(()=>resolve(site,[]),/probe/);
+        const target=resolve(site,[]);assert.equal(resolve(site,[]),target);assert.equal(calls,2);
+    });
+    it("does not cache a resolver that changes the path prefix", () => {
+        const root=fixture(),site=root.anyOf![0],target=root.$defs!.target;let calls=0;
+        site.resolveRef=({path}={})=>{calls++;path![0].pointer="#/changed";return target;};
+        const resolve=coverageReferences("#");
+        for(let i=0;i<2;i++){const path=[{node:root,pointer:"#"}];assert.equal(resolve(site,path),target);assert.equal(path[0].pointer,"#/changed");}
+        assert.equal(calls,2);
+    });

+        node.addRemoteSchema("https://audit.invalid/target",{properties:{a:{type:"number"},b:{type:"number"}}});
+        assert.equal(node.validate({a:1,b:2}).valid,true);
+        node.addRemoteSchema("https://audit.invalid/target",{properties:{a:{type:"string"},b:{type:"string"}}});
+        assert.equal(node.validate({a:1,b:2}).valid,false);assert.equal(node.validate({a:"a",b:"b"}).valid,true);
+    });
+    it("sees changes to a reused instance between public calls", () => {
+        const node=compileSchema({$defs:{target:{properties:{a:{type:"number"},b:{type:"number"}}}},anyOf:[{$ref:"#/$defs/target"}],unevaluatedProperties:false});
+        const data:{a:number|string,b:number}={a:1,b:2};
+        assert.equal(node.validate(data).valid,true);data.a="bad";assert.equal(node.validate(data).valid,false);data.a=1;assert.equal(node.validate(data).valid,true);
+    });
+    for(const count of [1,10,100]) {
+        it(`bounds target compilation across ${count} properties and resets next call`, () => {
+            let compilations=0;
+            const draft={...draft2020,keywords:[...draft2020.keywords,{id:"x-count",keyword:"x-count",parse:(node:SchemaNode)=>{if(node.schema["x-count"])compilations++;}}]};
+            const properties=Object.fromEntries(Array.from({length:count},(_,i)=>["p"+i,{type:"number"}]));
+            const node=compileSchema({$defs:{target:{"x-count":true,properties}},anyOf:[{$ref:"#/$defs/target"}],unevaluatedProperties:false},{drafts:[draft]});
+            const data=Object.fromEntries(Object.keys(properties).map(k=>[k,1]));

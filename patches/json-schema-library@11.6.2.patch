+        const valid = !result.some(isJsonError);
+        // Preserve existing synchronous validity, but never reuse pending work.
+        // Exceptions likewise leave no cached result. Diagnostics aren't cached.
+        if (!result.some((entry) => entry instanceof Promise)) {
+            results.set(node, valid);
+        }
+        return valid;
+    };
+}
